<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.3.0 Chrome/140.0.7339.249 Electron/38.7.2 Safari/537.36" version="29.3.0">
  <diagram id="fiap-soat-fase5-arch" name="1. Arquitetura Cloud Serverless AWS">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="title" value="FIAP Pós-Tech SOAT (Fase 5) - Arquitetura Cloud Serverless &amp; Gerenciada (AWS) | SAGA Orquestrada &amp; Segurança LGPD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1500" height="50" as="geometry" />
        </mxCell>

        <!-- Nós da Arquitetura -->
        <mxCell id="clients" value="Clientes Web / Mobile (UX Frontend)&#xa;&amp; Gateway de Pagamento Webhook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="waf" value="AWS Shield + CloudFront&#xa;+ AWS WAFv2&#xa;(OWASP Top 10, Rate Limit, TLS 1.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="120" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cognito" value="Amazon Cognito&#xa;(OAuth 2.0 / OIDC / JWT / MFA)&#xa;RBAC: Comprador, Vendedor, Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="330" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="apigw" value="Amazon API Gateway&#xa;(REST/HTTP API v1)&#xa;Throttling &amp; JWT Authorizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="650" y="210" width="220" height="160" as="geometry" />
        </mxCell>

        <mxCell id="compute" value="AWS Lambda / AWS Fargate&#xa;(.NET 8 Clean Architecture API)&#xa;- VeiculoUseCase (Ordenação Preço ASC)&#xa;- CompradorUseCase (AES-256-GCM + LGPD)&#xa;- CompraVeiculoSagaOrchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="110" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="sfn" value="AWS Step Functions&#xa;(Orquestrador SAGA Serverless)&#xa;1. Reserva c/ Lock Concorrência&#xa;2. Código Pagamento PIX/Boleto&#xa;3. Confirmação ou Compensação&#xa;4. Documentação ATPV-e e Baixa Estoque" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="340" width="300" height="180" as="geometry" />
        </mxCell>

        <mxCell id="aurora" value="Amazon Aurora PostgreSQL Serverless v2&#xa;(Sub-rede Privada Multi-AZ)&#xa;- Veículos (RowVersion Concurrency)&#xa;- Compradores (PII Cifrado AES-256-GCM&#xa;  + Blind Index HMAC-SHA256)&#xa;- PedidosCompra &amp; PassosSaga" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E0E7FF;strokeColor=#4F46E5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1310" y="100" width="250" height="190" as="geometry" />
        </mxCell>

        <mxCell id="dynamo" value="Amazon DynamoDB Serverless&#xa;- Locks Distribuídos de Reserva (TTL)&#xa;- Trilha Imutável de Auditoria LGPD" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E0E7FF;strokeColor=#4F46E5;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1310" y="345" width="250" height="165" as="geometry" />
        </mxCell>

        <mxCell id="kms" value="AWS KMS (FIPS 140-3 HSM) + AWS Secrets Manager + CloudTrail + CloudWatch + Macie&#xa;Criptografia Envelope AES-256-GCM | Rotação de Chaves | Monitoramento e Auditoria Contínua LGPD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#991B1B;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="590" width="1210" height="90" as="geometry" />
        </mxCell>

        <!-- Setas de Relacionamento com mxGeometry relative="1" -->
        <mxCell id="e1" value="HTTPS / TLS 1.3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#1E293B;fontStyle=1;" edge="1" parent="1" source="clients" target="waf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Autentica OAuth2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;fontStyle=1;" edge="1" parent="1" source="clients" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Tráfego Filtrado WAF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;fontStyle=1;" edge="1" parent="1" source="waf" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="Valida JWT / RBAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#D97706;fontStyle=1;" edge="1" parent="1" source="cognito" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="REST API /api/v1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontStyle=1;" edge="1" parent="1" source="apigw" target="compute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="Orquestra SAGA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9333EA;fontStyle=1;startArrow=classic;startFill=1;" edge="1" parent="1" source="compute" target="sfn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e7" value="ACID + AES-256-GCM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4F46E5;fontStyle=1;" edge="1" parent="1" source="compute" target="aurora">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e8" value="Lock Atômico &amp; AuditLog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#4F46E5;fontStyle=1;" edge="1" parent="1" source="sfn" target="dynamo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e9" value="Chaves CMK &amp; Segredos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#991B1B;dashed=1;fontStyle=1;" edge="1" parent="1" source="compute" target="kms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e10" value="Criptografia Disco &amp; PITR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#991B1B;dashed=1;fontStyle=1;" edge="1" parent="1" source="kms" target="dynamo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fiap-soat-fase5-saga" name="2. Orquestração SAGA e Compensações">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="stitle" value="Orquestração SAGA (Orchestrator Pattern) — Fluxo Feliz, Concorrência e Transações Compensatórias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3B0764;strokeColor=#1E1B4B;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1500" height="50" as="geometry" />
        </mxCell>

        <mxCell id="orch" value="ORQUESTRADOR CENTRAL SAGA (CompraVeiculoSagaOrchestrator / AWS Step Functions)&#xa;Controla Estado do PedidoCompra, Concorrência de Reserva, Timeouts e Aciona Rollbacks Semânticos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="860" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t1" value="Passo 1 (T1): Seleção e Reserva&#xa;- Valida Comprador Cadastrado (LGPD)&#xa;- Lock Atômico + RowVersion&#xa;- Status Veículo: Reservado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="310" height="120" as="geometry" />
        </mxCell>

        <mxCell id="t2" value="Passo 2 (T2): Código de Pagamento&#xa;- Valida CPF e Endereço Cobrança&#xa;- Emite Código (PAY-PIX-...)&#xa;- Status SAGA: AguardandoPagamento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="250" width="310" height="120" as="geometry" />
        </mxCell>

        <mxCell id="t3" value="Passo 3 (T3): Confirmação Pagamento&#xa;- Liquidação Financeira Aprovada&#xa;- Status Pagamento: Aprovado&#xa;- Status SAGA: PagamentoConfirmado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="250" width="310" height="120" as="geometry" />
        </mxCell>

        <mxCell id="t4" value="Passo 4 (T4): Retirada e Baixa Estoque&#xa;- Valida RG e CNH Vigente&#xa;- Emite ATPV-e (DETRAN) + NF-e&#xa;- Status Veículo: Vendido (Baixa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="250" width="330" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="Problema 1: Concorrência na Reserva&#xa;(Outro cliente reserva antes)&#xa;- Bloqueio Imediato (409 Conflict)&#xa;- Registra Auditoria de Conflito" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="310" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="Problema 2: Pagamento Não Efetuado / Timeout&#xa;(Compensação SAGA C2 + C1)&#xa;- Cancela Código de Pagamento&#xa;- Executa Veiculo.LiberarReserva() (Disponível)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="470" width="350" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="Problema 3: Desistência do Cliente em Qualquer Passo&#xa;(Compensação SAGA C3 + C2 + C1)&#xa;- Se já pago: Estorna Valor (EstornarPagamentoAsync)&#xa;- Executa Veiculo.LiberarReserva() (Disponível no Estoque)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="470" width="420" height="130" as="geometry" />
        </mxCell>

        <mxCell id="se1" value="Avanço T1 -&gt; T2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontStyle=1;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" value="Avanço T2 -&gt; T3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontStyle=1;" edge="1" parent="1" source="t2" target="t3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" value="Avanço T3 -&gt; T4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#16A34A;fontStyle=1;" edge="1" parent="1" source="t3" target="t4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" value="Conflito 409" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;dashed=1;fontStyle=1;" edge="1" parent="1" source="t1" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se5" value="Rollback Falha Pagto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;dashed=1;fontStyle=1;" edge="1" parent="1" source="t2" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se6" value="Rollback Desistência + Estorno" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#DC2626;dashed=1;fontStyle=1;" edge="1" parent="1" source="t3" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
